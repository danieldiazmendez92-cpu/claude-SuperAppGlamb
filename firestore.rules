rules_version = '2';

// GLAMB OS — Reglas de seguridad (Fase A)
// Modelo: un documento de estado (appState/main) + colección de usuarios/roles.
// Fase B endurecerá el acceso a nivel de campo (teléfono/finanzas server-side).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed()   { return request.auth != null; }
    function hasUserDoc() { return isAuthed() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin()    { return hasUserDoc() && myRole() == 'admin'; }
    function hasAccess()  { return hasUserDoc() && myRole() != 'pending'; }

    // Perfiles de usuario y roles
    match /users/{uid} {
      allow read: if isAuthed();
      // Auto-registro del propio perfil en el primer login: SIEMPRE como 'pending'
      // (no se puede auto-asignar un rol con acceso). Un admin lo habilita después.
      allow create: if (isAuthed() && request.auth.uid == uid && request.resource.data.role == 'pending')
                    || isAdmin();
      // Cambiar roles, nombres o dar de baja: solo admin
      allow update, delete: if isAdmin();
    }

    // Estado de la app (Fase A: documento único compartido)
    match /appState/{doc} {
      allow read, write: if hasAccess();
    }

    // Datos privados de contacto de clientes (Fase B)
    // Solo admin puede LEER. Cualquier usuario con acceso puede ESCRIBIR
    // (la recepcionista carga el teléfono del cliente pero no puede consultarlo después).
    match /clientsPrivate/{clientId} {
      allow read: if isAdmin();
      allow write: if hasAccess();
    }

    // Colecciones sincronizadas (Fase 3) — un documento por registro.
    // Dos usuarios editando registros distintos ya no se pisan.
    // Mismo nivel de acceso que el estado compartido: cualquier usuario habilitado.
    // clients/collaborators: movidos del blob a colección propia porque un único
    // documento con +1000 clientes superaba el límite de 1MB de Firestore y la
    // escritura fallaba. El doc compartido NO lleva phone/email (van a
    // clientsPrivate, solo-admin); mismo nivel de exposición que antes en el blob.
    match /clients/{id}        { allow read, write: if hasAccess(); }
    match /collaborators/{id}  { allow read, write: if hasAccess(); }
    match /appointments/{id}   { allow read, write: if hasAccess(); }
    match /payments/{id}       { allow read, write: if hasAccess(); }
    match /salesTickets/{id}   { allow read, write: if hasAccess(); }
    match /pendingCharges/{id} { allow read, write: if hasAccess(); }
    match /blockers/{id}       { allow read, write: if hasAccess(); }
    match /cashClosings/{id}   { allow read, write: if hasAccess(); }

    // Datos financieros sensibles (Fase B.2): nómina, comisiones, gastos,
    // impuestos, presupuestos. SOLO admin puede leer y escribir; recepción y
    // colaboradoras no pueden descargarlos ni siquiera consultando la base.
    match /financePrivate/{doc} {
      allow read, write: if isAdmin();
    }

    // Finanzas por-registro (gastos, deducciones, liquidaciones): un documento
    // por registro para que una copia vieja no pueda pisar el conjunto entero.
    // Mismo nivel de protección que financePrivate: SOLO admin.
    match /financeExpenses/{id}     { allow read, write: if isAdmin(); }
    match /financeDeductions/{id}   { allow read, write: if isAdmin(); }
    match /financeLiquidations/{id} { allow read, write: if isAdmin(); }

    // Registro de "ya le mandé este recordatorio", escrito SOLO por las Cloud
    // Functions (que usan el SDK admin y no pasan por estas reglas). La app lo
    // lee para mostrar en Pendientes a quién ya le escribió el servidor y no
    // ofrecer un envío manual duplicado. Solo admin: guarda emails de clientas.
    match /sentReminders/{id} {
      allow read: if isAdmin();
    }

    // Cola de emails — usada por la extensión "Trigger Email from Firestore".
    // Usuarios autenticados pueden crear documentos (encolar emails);
    // solo la extensión (service account) los lee y actualiza.
    match /mail/{id} {
      allow create: if hasAccess();
    }

    // Respuestas de encuestas de satisfacción (survey.html, página pública).
    // Cualquier visitante puede CREAR (enviar su calificación, sin auth).
    // Solo admin puede LEER para ver el panel de respuestas en la app.
    match /surveyResponses/{id} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Consentimientos informados (consentimiento.html, página pública por link).
    // Modelo de seguridad y de COSTO:
    //  - El documento lo CREA el salón al enviar el link (nunca el público), así
    //    nadie puede generar documentos ilimitados ni inflar la factura.
    //  - `get` público: el link lleva un token aleatorio que ES la credencial
    //    (mismo modelo que la encuesta). `list` queda solo para admin: sin esto
    //    cualquiera podría enumerar y descargar TODAS las fichas de salud.
    //  - `update` público: solo una vez (pendiente → firmado), sin vencer, y sin
    //    poder alterar a qué clienta pertenece ni el texto que se le mostró
    //    (snapshot inmutable: es la prueba de qué aceptó exactamente).
    //  - Recepción y colaboradoras pueden ENVIAR formularios, pero solo listan
    //    los que ellas mismas enviaron (la consulta debe filtrar por
    //    createdByUid, si no Firestore la rechaza). Así una colaboradora no
    //    puede descargar las fichas de salud de todas las clientas del salón.
    match /consentForms/{id} {
      allow get:    if true;
      allow list:   if isAdmin() || (hasAccess() && resource.data.createdByUid == request.auth.uid);
      allow create: if isAdmin() || (hasAccess() && request.resource.data.createdByUid == request.auth.uid
                                     && request.resource.data.status == 'pending');
      allow delete: if isAdmin() || (hasAccess() && resource.data.createdByUid == request.auth.uid
                                     && resource.data.status == 'pending');
      // El público solo puede tocar los campos de la firma: el snapshot, la
      // clienta y el vencimiento quedan blindados (cualquier intento de
      // modificarlos rechaza la escritura entera).
      allow update: if isAdmin() || (
                      resource.data.status == 'pending' &&
                      request.resource.data.status == 'signed' &&
                      request.time.toMillis() < resource.data.expiresAtMs &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status','answers','isMinor','representante','clientDni',
                        'signature','signerName','signedAt'
                      ])
                    );
    }

    // Todo lo demás: denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
