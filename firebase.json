{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "*.md",
      "firestore.rules",
      "functions/**",
      "glamb-os-working-v6.html",
      "glamb-os-stable.html",
      "caja-mockups.html"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "source": "/manifest.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      }
    ],
    "rewrites": [
      { "source": "**", "destination": "/glamb-os-firebase.html" }
    ]
  }
}
